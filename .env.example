# JWT — must match Token:AccessTokenKey in Petopia.Backend appsettings.json
JWT_SECRET=your-access-token-key-here
JWT_ISSUER=petopia.hcmut@gmail.com
JWT_ALGORITHM=HS256

# MongoDB
# Credentials must match MONGO_INITDB_ROOT_USERNAME/PASSWORD in docker-compose.yml
MONGODB_USERNAME=admin
MONGODB_PASSWORD=changeme
MONGODB_URL=mongodb://admin:changeme@localhost:27017/?authSource=admin
MONGODB_DB_NAME=petopia_chat

# Redis — reuse the existing Petopia.Backend Redis instance (no separate container)
REDIS_URL=redis://:changeme@localhost:6379

# CORS
CORS_ORIGINS=["http://localhost:3000"]
